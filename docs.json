          "anchor": "Report an Issue",
          "href": "https://app.enfue.com/job/enfuehelpdesk/issuereport?view=public",
          "icon": "bug"
        },
        {
          "anchor": "Suggest a Feature",
          "href": "https://app.enfue.com/job/enfuehelpdesk/featuresuggestion?view=public",
          "icon": "lightbulb"
        }
      ]
